rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Products catalog: Anyone can view, add, and manage products and reviews
    match /products/{productId} {
      allow read, write: if true;
    }
    
    // User Profiles: Users can read and write their own profile data
    match /users/{userId} {
      allow read, write: if isOwner(userId) || (isSignedIn() && request.auth.uid == userId);
    }

    // Orders: Anyone (guest or registered) can submit an order, registered users or admin can read and manage
    match /orders/{orderId} {
      allow create, read: if true;
      allow update, delete: if isSignedIn();
    }
  }
}

