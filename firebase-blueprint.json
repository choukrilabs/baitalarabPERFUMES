{
  "collections": [
    {
      "name": "products",
      "description": "Products catalog including perfumes, abayas, and honey",
      "fields": [
        { "name": "name", "type": "string" },
        { "name": "category", "type": "string" },
        { "name": "price", "type": "number" },
        { "name": "originalPrice", "type": "number", "optional": true },
        { "name": "volume", "type": "string", "optional": true },
        { "name": "description", "type": "string" },
        { "name": "image", "type": "string" },
        { "name": "active", "type": "boolean" },
        { "name": "isFeatured", "type": "boolean" },
        { "name": "notes", "type": "array", "items": { "type": "string" } }
      ]
    }
  ]
}
